# --- Required -----------------------------------------------------------------

# Repo URL or email, sent in the User-Agent. Wikimedia blocks requests that
# carry no way to contact the operator. Left blank, every run stops with a
# message saying so.
POTD_CONTACT=

# Google Cloud Translation API key (README: "Run" has the setup steps).
# Left blank, the run still works but the proverb goes on the image untranslated.
POTD_GOOGLE_TRANSLATE_API_KEY=

# --- Optional: uncomment to change a default -----------------------------------

# Languages the proverb is translated through before coming back to English.
# An empty value turns translation off.
# POTD_TRANSLATION_LANGUAGES=ja,sw,ka,fi,zh-CN,eu,mg,th

# Where the overlay text comes from: wiktionary, or lorem for offline filler.
# POTD_QUOTE_PROVIDER=wiktionary

# Output directory, relative to where the command is run.
# POTD_OUTPUT_DIR=output

# Width requested from Commons. Commons rounds up to its nearest cached size.
# POTD_THUMBNAIL_WIDTH=1600

# A specific TrueType file. Default: the bundled font, then system fonts.
# POTD_FONT=
