# Generated output. The scheduled workflow commits each day's folder -- the
# archive lives in the repo -- minus the downloaded source image, which is only
# a cache, and temp files left by an interrupted run.
output/*/source.*
output/**/.*.part*

# The Pages site is rebuilt from output/ on every run and never committed.
_site/

